%---------------------------------------------------------------------------%
%                                                                           %
%                              MPT COLOR THEME                              %
%                                                                           %
%---------------------------------------------------------------------------%

\ProvidesPackage{beamercolorthemeMPTM}[2017/09/14 Mines ParisTech beamer color theme] 

\mode<presentation>

%---------------------------------------------------------------------------%
%                                 MPT COLORS                                %
%---------------------------------------------------------------------------%

%---------- OFFICIAL COLORS
\definecolor{MPTblue}{RGB}{0,94,158}
\definecolor{MPTgrey}{RGB}{156,158,159}

%---------- VARIANTS
\definecolor{MPTlightblue}{RGB}{0,111,182}
\definecolor{MPTlightgrey}{RGB}{240,240,240}
\definecolor{MPTred}{RGB}{192,80,77}
%\definecolor{MPTcop}{RGB}{197,110,34}
%\definecolor{MPTred}{RGB}{197,110,34}

%---------- FOR BOOKTABS
\colorlet{main}{MPTgrey}

%-------------------------------- BACKGROUND -------------------------------%

\setbeamercolor{background canvas}{parent = normal text, bg = white}
\setbeamercolor{background}{parent = background canvas, bg = white}

%----------------------------------- TEXT ----------------------------------%

%---------- TEXT MODE
\setbeamercolor{normal text}{fg = black, bg = }
\ifbool{\@alertred}{
\setbeamercolor{alerted text}{fg = white, bg = MPTred}
}{
\setbeamercolor{alerted text}{fg = white, bg = MPTblue}
}
\setbeamercolor{example text}{parent = normal text}

%---------- MATH MODE
\setbeamercolor{math text}{parent = normal text}
\setbeamercolor{math text inlined}{parent = math text}
\setbeamercolor{math text displayed}{parent = math text}
\setbeamercolor{normal text in math text}{parent = math text}

%--------------------------- OUTER THEME ELEMENTS --------------------------%

\setbeamercolor{structure}{fg = MPTblue, bg = white}

%---------- IN FRAME
\setbeamercolor{palette primary}{parent = structure}
\setbeamercolor{palette secondary}{use = structure, fg = structure.fg!75!normal text.fg, bg = }
\setbeamercolor{palette tertiary}{use = structure, fg = structure.fg!50!normal text.fg, bg = }
\setbeamercolor{palette quaternary}{parent = normal text}

%---------- IN FOOTLINE
\setbeamercolor{page number in head/foot}{fg = MPTblue, bg =}
\setbeamerfont{page number in head/foot}{series = \bfseries}


%-------------------------------- TITLE PAGE -------------------------------%

\setbeamercolor{local structure}{parent = structure}

%---------- TITLE
\setbeamercolor{title}{bg = MPTblue, fg = MPTblue}

%---------- AUTHOR
\setbeamercolor{author}{bg = MPTgrey, fg = MPTblue}
%\setbeamercolor{author}{bg =MPTgrey , fg = MPTgrey!75!black}

%---------- COAUTHORS
\setbeamercolor{coauthor}{bg = , fg = MPTgrey!75!black}
%\setbeamercolor{coauthor}{bg = , fg = MPTblue}

%---------- INSTITUTE
\setbeamercolor{institute}{bg = , fg = MPTgrey!75!black}

%---------- INSTITUTE OF COAUTHORS
\setbeamercolor{coinstitute}{parent = institute}

%---------- EVENT
\setbeamercolor{event}{bg = MPTlightgrey, fg = MPTgrey!75!black}

%---------- DATE
\setbeamercolor{date}{bg = , fg = MPTgrey!75!black}

%---------- GRAPHICS
\setbeamercolor{titlegraphic}{bg = }
\setbeamercolor{logo}{bg = }

%--------------------------------- SECTIONS --------------------------------%

%---------- PART
\setbeamercolor{part name}{parent = structure}
\setbeamercolor{part title}{parent = normal text}

%---------- SECTION
\setbeamercolor{section name}{fg = MPTblue}
\setbeamercolor{section title}{parent = part title}
\setbeamercolor{section in toc}{parent = structure}
\setbeamercolor{section in toc shaded}{parent = section in toc, bg = white}
\setbeamercolor{section number projected}{fg = MPTblue, bg = }

%---------- SUBSECTION
\setbeamercolor{subsection name}{parent = section name}
\setbeamercolor{subsection title}{parent = section title}
\setbeamercolor{subsection in toc}{parent = section in toc, fg = normal text.fg}
\setbeamercolor{subsection in toc shaded}{parent = subsection in toc, bg = white}
\setbeamercolor{subsection number projected}{parent = section number projected, bg=}

%---------- SUBSUBSECTION
\setbeamercolor{subsubsection in toc}{parent = subsection in toc}
\setbeamercolor{subsubsection in toc shaded}{parent = subsubsection in toc, bg = white}
\setbeamercolor{subsubsection number projected}{parent = section number projected}

%----------------------------------- LINES ---------------------------------%

\setbeamercolor{headline}{bg = black}
\setbeamercolor{footline}{bg = black}

%---------------------------------- FRAMES ---------------------------------%

%---------- TITLES
\setbeamercolor{frametitle}{fg = MPTblue, bg = }
\setbeamercolor{framesubtitle}{parent = frametitle}
\setbeamercolor{frametitle right}{parent = frametitle}

%---------- CAPTION
\setbeamercolor{caption}{bg = }
\setbeamercolor{caption name}{parent = normal text}

%---------- BUTTONS
\setbeamercolor{button}{use = local structure, bg = MPTgrey, fg = white}
\setbeamercolor{button border}{use = button, fg = button.bg}

%---------- MINI FRAME
\setbeamercolor{mini frame}{parent = normal text}

%---------------------------------- BLOCKS ---------------------------------%

%---------- BODY
\setbeamercolor{block body}{parent = normal text, bg = MPTlightgrey!50!white}
\setbeamercolor{block body blue}{parent = normal text, bg = MPTlightgrey!50!white}
\setbeamercolor{block body alerted}{parent = normal text, bg = MPTlightgrey!50!white}
\setbeamercolor{block body example}{parent = normal text, bg = white}

%---------- TITLE
\setbeamercolor{block title}{bg = MPTgrey!50!white, fg = black}
\setbeamercolor{block title blue}{bg = MPTblue, fg = black}
\ifbool{\@alertred}{
\setbeamercolor{block title alerted}{bg = MPTred, fg = MPTlightgrey}
}
{
\setbeamercolor{block title alerted}{bg = MPTblue, fg = white}
}
\setbeamercolor{block title example}{bg = MPTgrey!50!white, fg = MPTblue}

%---------------------------------- LISTS ----------------------------------%

%---------- NORMAL MODE
\setbeamercolor{item}{bg = MPTblue, fg = white}
\setbeamercolor{subitem}{parent = item}
\setbeamercolor{subsubitem}{parent = subitem}

%---------- PROJECTED MODE
\setbeamercolor{item projected}{parent = item, use = item, fg = white, bg = item.fg}
\setbeamercolor{subitem projected}{parent = item projected}
\setbeamercolor{subsubitem projected}{parent = subitem projected}

%---------- ENUMERATE
\setbeamercolor{enumerate item}{parent = item}
\setbeamercolor{enumerate subitem}{parent = subitem}
\setbeamercolor{enumerate subsubitem}{parent = subsubitem}

%---------- ITEMIZE
\setbeamercolor{itemize item}{parent = item}
\setbeamercolor{itemize subitem}{parent = subitem}
\setbeamercolor{itemize subsubitem}{parent = subsubitem}
\setbeamercolor{description item}{parent = item}

%---------------------------------- BIBLIO ---------------------------------%

\setbeamercolor{bibliography item}{parent = item}

\setbeamercolor{bibliography entry author}{use = structure, fg = structure.fg}
\setbeamercolor{bibliography entry title}{use = normal text, fg = normal text.fg}
\setbeamercolor{bibliography entry location}{use = structure, fg = structure.fg!65!bg}
\setbeamercolor{bibliography entry note}{use = structure, fg = structure.fg!65!bg}

\setbeamercolor{separation line}{bg =}

\setbeamercolor{upper separation line head}{parent = separation line}
\setbeamercolor{middle separation line head}{parent = separation line}
\setbeamercolor{lower separation line head}{parent = separation line}

\setbeamercolor{upper separation line foot}{parent = separation line}
\setbeamercolor{middle separation line foot}{parent = separation line}
\setbeamercolor{lower separation line foot}{parent = separation line}

\setbeamercolor{abstract}{bg =}
\setbeamercolor{abstract title}{parent = structure, bg =}

\setbeamercolor{verse}{}

\setbeamercolor{quotation}{}
\setbeamercolor{quote}{parent = quotation}


\setbeamercolor{qed symbol}{parent = structure, bg =}

\mode
<all>
