%---------- FRAMED TEXT
\newcommand{\ssbox}[1]{
  \begin{tikzpicture}[baseline = (O.base), text depth = 0]%
  \node[inner sep = 5pt, fill = MPTlightgrey!50!white, minimum height = 1ex, text centered] (O) at (0,0) {#1};
  \end{tikzpicture}
}

%---------- MPT TYPE TITLE
\newcommand{\mtitle}[1]{
		%----- LENGTHS
		\setlength{\bsq}{\titleftwd}
		\setlength{\ssq}{.66\bsq}
		\setlength{\sepssq}{.5\insep}
		\setlength{\shadowsq}{1pt}
		%----- COLORS
		\usebeamercolor{normal text}
		\usebeamercolor{title}
   	\begin{tikzpicture} [overlay, remember picture, inner sep = 0pt, outer sep = 0pt]
	   	%
	   	%----- TITLE
		\node [text width = \paperwidth - 4\Ztwo - \bsq - \insep - 2\ssq - \sepssq - \insep - \shadowsq] (title) at (current page.center) {\color{title.fg}\usebeamerfont{title}#1\hspace{5pt}{\color{author.bg}}};
		
		%----- BIG SQUARE
		\fill [drop shadow = {shadow xshift = \shadowsq, shadow yshift = - \shadowsq}, fill = MPTblue] ([xshift = - \insep]title.north west) rectangle ([xshift = - \insep - \bsq, yshift = -\bsq]title.north west);
		%
		%----- SMALL SQUARES
		\fill [drop shadow = {shadow xshift = \shadowsq, shadow yshift = - \shadowsq}, fill = MPTgrey] ([xshift = \insep]title.south east) rectangle ([xshift = \insep + \ssq, yshift = \ssq]title.south east);
		%
		\fill [drop shadow = {shadow xshift = \shadowsq, shadow yshift = - \shadowsq}, fill = black] ([xshift = \insep + \ssq + \sepssq]title.south east) rectangle ([xshift = \insep + 2\ssq + \sepssq, yshift = \ssq]title.south east);	
	\end{tikzpicture}
}
	
