%---------------------- MACRO FOR LIST OF NEWCOMMANDS ----------------------%
\makeatletter
\newcommand{\generate}[4]{%
	\def\@tempa{#1}
	\count@=`#3
	\loop
	\begingroup\lccode`?=\count@
	\lowercase{\endgroup\@namedef{\@tempa ?}{#2{?}}}%
	\ifnum\count@<`#4
	\advance\count@\@ne
	\repeat
}
%-- USAGE : \generate{<prefix>}{<macro>}{<starting point>}{<end point>}

