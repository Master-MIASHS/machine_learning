%----- COAUTHORS
\newcommand\@coone{}
\newcommand\@cotwo{}
\newcommand*\coauthor[2][1]{%
	\ifnumequal{#1}{1}{\renewcommand{\@coone}{#2}}{
		\ifnumequal{#1}{2}{\renewcommand{\@cotwo}{#2}}{}}}

%----- AFFILIATIONS OF COAUTHORS (ex. Centre de Géosciences, Equipe Géostatistique)
\newcommand\@coinsuone{} \newcommand\@coinscone{} \newcommand\@coinstone{}
\newcommand\@coinsutwo{} \newcommand\@coinsctwo{} \newcommand\@coinsttwo{}
\newcommand*\coinstitute[4][1]{%
	\ifnumequal{#1}{1}{\renewcommand{\@coinsuone}{#2}\renewcommand{\@coinscone}{#3} \renewcommand{\@coinstone}{#4}}{
		\ifnumequal{#1}{2}{\renewcommand{\@coinsutwo}{#2}\renewcommand{\@coinsctwo}{#3} \renewcommand{\@coinsttwo}{#4}}{}}}

%----- INSTITUTE
\newcommand\@instituteu{}
\newcommand\@institutec{}
\newcommand\@institutet{}
%\renewcommand\institute[2]{\renewcommand\@institutec{#1}\renewcommand\@institutet{#2}}
\renewcommand\institute[3]{\renewcommand\@instituteu{#1}\renewcommand\@institutec{#2} \renewcommand\@institutet{#3}}



%----- EVENT
\newcommand\@event{}
\newcommand\event[1]{\renewcommand\@event{#1}}

%----- DATE 
\renewcommand\date[1]{\renewcommand\@date{#1}}

%----- TITLE
\renewcommand\title[1]{\renewcommand\@title{#1}}

%----- SUBTITLE (ex. An introduction)
\newcommand\@subtitle{}
\renewcommand\subtitle[1]{\renewcommand\@subtitle{#1}}

%----- ILLUSTRATION
\newcommand{\theillustration}{}
\newcommand{\illustration}[1]{\renewcommand{\theillustration}{#1}}

%----- RESEARCH CENTER LOGOS 
\newcommand*{\@rclogo}{}
\newcommand*\rclogo[1]{\forcsvlist{\listadd\@rclogo}{#1}}

%----- NETWORK LOGOS 
\newcommand*{\@netlogo}{}
\newcommand*\netlogo[1]{\forcsvlist{\listadd\@netlogo}{#1}}

%---------------------------------------------------------------------------%
% LIST ENVIRONMENTS                                                         %
%---------------------------------------------------------------------------%

\usebeamercolor{normal text}

%----- ITEM BULLET ---------------------------------------------------------%

\newcommand{\zig}[2][normal text.fg]{
\begin{tikzpicture}[scale = #2]
\fill[fill = #1, drop shadow = {shadow xshift = 0pt, shadow yshift = -0pt}] (0,1) rectangle (2,-1);
\end{tikzpicture}
}
%\begin{tikzpicture}[scale = #2]
%\fill[fill = #1, drop shadow = {shadow xshift = 0pt, shadow yshift = -0pt}] (1,0) circle (1);
%\end{tikzpicture}
%}

%----- ENUMERATE BULLET ----------------------------------------------------%

\newcommand{\zignb}[3][normal text.fg]{
%\raisebox{-1.25pt}{
\begin{tikzpicture}[baseline = (O.base), text depth = 0, scale = #2]
\node[text centered, fill = #1, inner sep = 1.25pt, outer sep = 0pt, drop shadow = {shadow xshift = 0pt, shadow yshift = -0pt}] (O) at (0,0) {\usebeamercolor[fg]{enumerate item.fg} \bfseries #3};
\end{tikzpicture}
}%}
 
%----- ITEMIZE ITEMS -------------------------------------------------------%

\defbeamertemplate{itemize item}{MPT theme}{\usebeamercolor{itemize item} \zig[itemize item.bg]{0.1}}
\defbeamertemplate{itemize subitem}{MPT theme}{\usebeamercolor{itemize subitem} \zig[itemize subitem.bg]{0.09}}
\defbeamertemplate{itemize subsubitem}{MPT theme}{\usebeamercolor{itemize subsubitem} \zig[itemize subsubitem.bg]{0.08}}
\setbeamertemplate{itemize item}[MPT theme]
\setbeamertemplate{itemize subitem}[MPT theme]
\setbeamertemplate{itemize subsubitem}[MPT theme]
 
%----- ENUMERATE ITEMS -----------------------------------------------------%

\defbeamertemplate{enumerate item}{MPT theme}{\usebeamercolor{enumerate item} \zignb[enumerate item.bg]{0.18}{\insertenumlabel}}
\defbeamertemplate{enumerate subitem}{MPT theme}{\usebeamercolor{enumerate subitem} \zignb[enumerate subitem.bg]{0.16}{\insertsubenumlabel}}
\defbeamertemplate{enumerate subsubitem}{MPT theme}{\usebeamercolor{enumerate subsubitem} \zignb[enumerate subsubitem.bg]{0.14}{\insertsubsubenumlabel}}
\setbeamertemplate{enumerate item}[MPT theme]
\setbeamertemplate{enumerate subitem}[MPT theme]
\setbeamertemplate{enumerate subsubitem}[MPT theme]


%---------------------------------------------------------------------------%
% ALERT ENVIRONMENT                                                         %
%---------------------------------------------------------------------------%

\renewcommand<>{\alert}[2][2]{
	%----- COLORS
	\usebeamercolor{alerted text}%
	\usebeamercolor{normal text}%
	%
	%----- TEXT
	\hspace*{-#1pt}%
	%\raisebox{-2pt}{%
	\begin{tikzpicture}[baseline = (O.base), text depth = 0]%
	\node[text width = , fill = alerted text.bg, inner sep = 2pt, drop shadow = {shadow xshift = 1.25pt, shadow yshift = -1.25pt}] (O) {\color{alerted text.fg}#2};
	\end{tikzpicture}%
	%}
	\hspace*{#1pt}%
}

%----- IN MATH MODE
\newcommand<>{\alertm}[1]{\text{\alert{$#1$}}}

%----- IN A POWER (x^2)
\newcommand<>{\alertp}[1]{\text{\alert[1.5]{$#1$}}}

%---------------------------------------------------------------------------%
% BLOCK ENVIRONMENT                                                         %
%---------------------------------------------------------------------------%

%----- BLOCK MASK ----------------------------------------------------------%

\tikzset{block/.style = {very thick, outer ysep = 0.2ex, inner sep = 5pt}}

\newenvironment<>{blockmask}[3][.9675]{
  %----- COLORS
  \ifstrempty{#2}{
  \def\btcol{block title} \def\bbcol{block body}}{
  \def\btcol{block title #2} \def\bbcol{block body #2}}
  \usebeamercolor{\btcol}
  \usebeamercolor{\bbcol}
  
  \begin{tikzpicture}
  %----- ORIGIN
  \node [inner sep = 0pt, outer sep = 0pt] (O) at (0,0) {};
  
  %----- TITLE
  \ifdefmacro{#3}{\ifdefempty{#3}{}{
  \node [anchor = south, text width = #1\textwidth, draw = \btcol.bg, block, fill = \btcol.bg, minimum height = 1ex, above = -.5pt, text centered] (title) at (O.north) {\usebeamerfont{\btcol}\color{\btcol.fg}#3};%
  }}{ %
  \ifstrempty{#3}{}{
  \node [anchor = south, text width = #1\textwidth, draw = \btcol.bg, block, fill = \btcol.bg, minimum height = 1ex, above = -.5pt, text centered] (title) at (O.north) {\usebeamerfont{\btcol}\color{\btcol.fg}#3};}}
  
  %----- BODY
  \node [anchor = north, text width = #1\textwidth, draw = \btcol.bg, block, fill = \bbcol.bg] (body) at (O.south) \bgroup\begin{minipage}[t]{\textwidth}%
  \usebeamerfont{\bbcol}\color{\bbcol.fg}%
}
{%
  \end{minipage}\egroup;
  \end{tikzpicture}
}

%----- NORMAL BLOCK --------------------------------------------------------%

\defbeamertemplate*{block begin}{MPT theme}{\begin{blockmask}{}{\insertblocktitle}}
\defbeamertemplate*{block end}{MPT theme}{\end{blockmask}}
\setbeamertemplate{block}[MPT theme]

%----- EXAMPLE BLOCK -------------------------------------------------------%

\defbeamertemplate*{block example begin}{MPT theme}{\begin{blockmask}{example}{\insertblocktitle}}
\defbeamertemplate*{block example end}{MPT theme}{\end{blockmask}}
\setbeamertemplate{block example}[MPT theme]

%----- ALERTED BLOCK -------------------------------------------------------%

\defbeamertemplate*{block alerted begin}{MPT theme}{\begin{blockmask}{alerted}{\insertblocktitle}}
\defbeamertemplate*{block alerted end}{MPT theme}{\end{blockmask}}
\setbeamertemplate{block alerted}[MPT theme]

%----- BLOCKS WITH VARIABLE WIDTH ------------------------------------------%
\newenvironment<>{vblock}[2][.97]{\begin{blockmask}[#1]{}{#2}}{ %
\end{blockmask}}
\newenvironment<>{vblockb}[2][.97]{\begin{blockmask}[#1]{blue}{#2}}{ %
\end{blockmask}}
\newenvironment<>{vexblock}[2][.97]{\begin{blockmask}[#1]{example}{#2}}{ %
\end{blockmask}}
\newenvironment<>{valblock}[2][.97]{\begin{blockmask}[#1]{alerted}{#2}}{ %
\end{blockmask}}

%---------------------------------------------------------------------------%
% TABLE OF CONTENTS                                                         %
%---------------------------------------------------------------------------%

\ifdef{\secnr}{}{
	\newif\ifstarred
	\def\secnr{}
	\pretocmd\beamer@@ssection{\gdef\secnr{}\global\starredtrue}{}{}
	\patchcmd\beamer@section{by 1\relax}{by 1\relax\xdef\secnr{\the\beamer@tocsectionnumber}\global\starredfalse}{}{}
}

%----- SECTION -------------------------------------------------------------%

\defbeamertemplate*{section in toc}{MPT theme}{
	%----- COLORS
	\usebeamercolor{section name}
	\usebeamercolor{section in toc}
	\usebeamercolor{normal text}
	
	%----- TEXT
	\hspace{8.65ex}
	\llap{\raisebox{0.1ex}{{\bfseries \large \color{section name.fg} \MakeUppercase{\romannumeral\inserttocsectionnumber}}{\color{section name.fg}\,\scalebox{0.25}{\ding{110}}}}\kern1ex}{{\color{section in toc.fg}\usebeamerfont{section in toc} \inserttocsection}}
	\vspace{.25em}
	%{\bfseries \large \color{section name.fg} \MakeUppercase{\romannumeral\inserttocsectionnumber}
}
\setbeamertemplate{section in toc}[MPT theme]

\defbeamertemplate*{section in toc shaded}{MPT theme}[1][20]{
	%----- COLORS
	\usebeamercolor{section in toc shaded}
	
	%----- TEXT
	\begin{colormixin}{#1!section in toc shaded.bg}
	\usebeamertemplate{section in toc}
	\end{colormixin}\unskip
}
\setbeamertemplate{section in toc shaded}[MPT theme]

%-------------------------------- SUBECTION --------------------------------%

\defbeamertemplate*{subsection in toc}{MPT theme}{
	%---------- COLORS
	\usebeamercolor{subsection name}
	\usebeamercolor{subsection in toc}
	\usebeamercolor{normal text}
	
	%---------- TEXT
	\leavevmode\leftskip=12.65ex%
	\llap{\raisebox{0.2ex}{\zig[subsection name.fg]{0.085}}\kern1ex}%
	\color{subsection in toc.fg} \usebeamerfont{subsection in toc} \inserttocsubsection\par%
	\vspace{0.05em}
}
\setbeamertemplate{subsection in toc}[MPT theme]

\defbeamertemplate*{subsection in toc shaded}{MPT theme}[1][10]{
	%---------- COLORS
	\usebeamercolor{subsection in toc shaded}
	
	%---------- TEXT
	\begin{colormixin}{#1!subsection in toc shaded.bg}
	\usebeamertemplate{subsection in toc}
	\end{colormixin}\unskip
}
\setbeamertemplate{subsection in toc shaded}[MPT theme]

